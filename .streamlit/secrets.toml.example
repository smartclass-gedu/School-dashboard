# Database connection configuration for the School Dashboard.
# Copy this file to .streamlit/secrets.toml and fill in with real values.
#
# Local development: point to your Docker MariaDB container
# Streamlit Cloud: update with your cloud-hosted database credentials
#
# IMPORTANT: .streamlit/secrets.toml is in .gitignore and will never be
# committed. Only this .example file is tracked in git.

#[db]
#host = "localhost"
#port = 3306
#user = "school_user"
#password = "your_password_here"
#database = "school_data"

# Example for Streamlit Cloud with Aiven (or other managed database):
[db]
host = "mysql-650f467-gedu-4ef1.b.aivencloud.com"
port = 21131
user = "avnadmin"
password = "AVNS_ZiHY6dRaFt8CVGSVonM"
database = "defaultdb"
ssl_ca = "certs/aiven-ca.pem"   # Path relative to repo root; must be committed to repo
